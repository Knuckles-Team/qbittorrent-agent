@prefix qbt: <https://knuckles-team.github.io/ontology/connector/qbittorrent#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Tool-use contracts, skills and agent definitions of the qbittorrent-mcp
# connector (CONN-QBITTORRENT-AGENT-SURFACE-R004, R005).

qbt:tool-qbittorrent_app_default_save_path a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_app_default_save_path" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_app_preferences a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_app_preferences" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_ingest_torrents a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_ingest_torrents" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_log_main a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_log_main" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_add a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_add" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_categories a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_categories" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_count a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_count" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_create_category a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_create_category" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_info a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_info" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_properties a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_properties" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_reannounce a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_reannounce" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_recheck a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_recheck" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_remove_categories a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_remove_categories" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_set_share_limits a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_set_share_limits" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_torrents_trackers a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_torrents_trackers" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_download_limit a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_download_limit" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_info a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_info" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_set_download_limit a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_set_download_limit" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_set_upload_limit a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_set_upload_limit" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_speed_limits_mode a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_speed_limits_mode" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:tool-qbittorrent_transfer_upload_limit a qbt:ConnectorTool ;
    qbt:toolName "qbittorrent_transfer_upload_limit" ;
    qbt:toolOf qbt:app-qbittorrent .

qbt:skill-qbittorrent-torrent-lifecycle a qbt:ConnectorSkill ;
    rdfs:label "qBittorrent Torrent Lifecycle" ;
    qbt:skillName "qbittorrent-torrent-lifecycle" .

qbt:skill-qbittorrent-transfer-tuning a qbt:ConnectorSkill ;
    rdfs:label "qBittorrent Transfer Tuning" ;
    qbt:skillName "qbittorrent-transfer-tuning" .

qbt:skill-qbittorrent-download-client a qbt:ConnectorSkill ;
    rdfs:label "qBittorrent as the Media Apps' Download Client" ;
    qbt:skillName "qbittorrent-download-client" .

qbt:skill-qbittorrent-kg-ingestion a qbt:ConnectorSkill ;
    rdfs:label "qBittorrent Knowledge-Graph Ingestion" ;
    qbt:skillName "qbittorrent-kg-ingestion" .

qbt:skill-qbittorrent-agent-operations a qbt:ConnectorSkill ;
    rdfs:label "qBittorrent Operations" ;
    qbt:skillName "qbittorrent-agent-operations" .

qbt:contract-qbittorrent-check-transfer-health a qbt:ToolUseContract ;
    rdfs:label "Check transfer health" ;
    rdfs:comment "Read the connection status, speeds and limits, and list stalled and errored torrents with the log reasons." ;
    qbt:contractOf qbt:skill-qbittorrent-transfer-tuning ;
    qbt:hasStep qbt:step-qbittorrent-check-transfer-health-1, qbt:step-qbittorrent-check-transfer-health-2, qbt:step-qbittorrent-check-transfer-health-3, qbt:step-qbittorrent-check-transfer-health-4, qbt:step-qbittorrent-check-transfer-health-5 .

qbt:step-qbittorrent-check-transfer-health-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "`connection_status` must be `connected`; speeds, totals and DHT nodes." ;
    qbt:precedesStep qbt:step-qbittorrent-check-transfer-health-2 .

qbt:step-qbittorrent-check-transfer-health-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_speed_limits_mode ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "`1` means the alternative (slower) limits are on." ;
    qbt:precedesStep qbt:step-qbittorrent-check-transfer-health-3 .

qbt:step-qbittorrent-check-transfer-health-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Stalled torrents (no peers or no progress)." ;
    qbt:precedesStep qbt:step-qbittorrent-check-transfer-health-4 ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-3-filter .

qbt:param-qbittorrent-check-transfer-health-3-filter a qbt:ParameterBinding ;
    qbt:parameterName "filter" ;
    qbt:parameterSource "const:\"stalled\"" .

qbt:step-qbittorrent-check-transfer-health-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Errored torrents (missing files, disk errors)." ;
    qbt:precedesStep qbt:step-qbittorrent-check-transfer-health-5 ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-4-filter .

qbt:param-qbittorrent-check-transfer-health-4-filter a qbt:ParameterBinding ;
    qbt:parameterName "filter" ;
    qbt:parameterSource "const:\"errored\"" .

qbt:step-qbittorrent-check-transfer-health-5 a qbt:ContractStep ; ;
    qbt:stepIndex 5 ; ;
    qbt:callsTool qbt:tool-qbittorrent_log_main ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Warnings and critical messages: failed logins, IP bans, disk and tracker errors." ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-5-normal ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-5-info ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-5-warning ;
    qbt:bindsParameter qbt:param-qbittorrent-check-transfer-health-5-critical .

qbt:param-qbittorrent-check-transfer-health-5-normal a qbt:ParameterBinding ;
    qbt:parameterName "normal" ;
    qbt:parameterSource "const:false" .

qbt:param-qbittorrent-check-transfer-health-5-info a qbt:ParameterBinding ;
    qbt:parameterName "info" ;
    qbt:parameterSource "const:false" .

qbt:param-qbittorrent-check-transfer-health-5-warning a qbt:ParameterBinding ;
    qbt:parameterName "warning" ;
    qbt:parameterSource "const:true" .

qbt:param-qbittorrent-check-transfer-health-5-critical a qbt:ParameterBinding ;
    qbt:parameterName "critical" ;
    qbt:parameterSource "const:true" .

qbt:contract-qbittorrent-recover-stalled-torrent a qbt:ToolUseContract ;
    rdfs:label "Recover a stalled torrent" ;
    rdfs:comment "For one stalled torrent, read its trackers, reannounce, and recheck it if its data may be damaged." ;
    qbt:contractOf qbt:skill-qbittorrent-torrent-lifecycle ;
    qbt:hasStep qbt:step-qbittorrent-recover-stalled-torrent-1, qbt:step-qbittorrent-recover-stalled-torrent-2, qbt:step-qbittorrent-recover-stalled-torrent-3, qbt:step-qbittorrent-recover-stalled-torrent-4, qbt:step-qbittorrent-recover-stalled-torrent-5 .

qbt:step-qbittorrent-recover-stalled-torrent-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Pick the stalled torrent by `hash`." ;
    qbt:precedesStep qbt:step-qbittorrent-recover-stalled-torrent-2 ;
    qbt:bindsParameter qbt:param-qbittorrent-recover-stalled-torrent-1-filter .

qbt:param-qbittorrent-recover-stalled-torrent-1-filter a qbt:ParameterBinding ;
    qbt:parameterName "filter" ;
    qbt:parameterSource "const:\"stalled\"" .

qbt:step-qbittorrent-recover-stalled-torrent-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_trackers ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Tracker status 4 (not working) or a message names the cause." ;
    qbt:precedesStep qbt:step-qbittorrent-recover-stalled-torrent-3 ;
    qbt:bindsParameter qbt:param-qbittorrent-recover-stalled-torrent-2-hash .

qbt:param-qbittorrent-recover-stalled-torrent-2-hash a qbt:ParameterBinding ;
    qbt:parameterName "hash" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:step-qbittorrent-recover-stalled-torrent-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_reannounce ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Ask the trackers for peers again." ;
    qbt:precedesStep qbt:step-qbittorrent-recover-stalled-torrent-4 ;
    qbt:bindsParameter qbt:param-qbittorrent-recover-stalled-torrent-3-hashes .

qbt:param-qbittorrent-recover-stalled-torrent-3-hashes a qbt:ParameterBinding ;
    qbt:parameterName "hashes" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:step-qbittorrent-recover-stalled-torrent-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_recheck ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required: rehashes the data on disk (slow on large torrents)." ;
    qbt:precedesStep qbt:step-qbittorrent-recover-stalled-torrent-5 ;
    qbt:bindsParameter qbt:param-qbittorrent-recover-stalled-torrent-4-hashes .

qbt:param-qbittorrent-recover-stalled-torrent-4-hashes a qbt:ParameterBinding ;
    qbt:parameterName "hashes" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:step-qbittorrent-recover-stalled-torrent-5 a qbt:ContractStep ; ;
    qbt:stepIndex 5 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_properties ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Confirm peers, seeds and progress after the reannounce." ;
    qbt:bindsParameter qbt:param-qbittorrent-recover-stalled-torrent-5-hash .

qbt:param-qbittorrent-recover-stalled-torrent-5-hash a qbt:ParameterBinding ;
    qbt:parameterName "hash" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:contract-qbittorrent-category-roundtrip a qbt:ToolUseContract ;
    rdfs:label "Prove category writes with a test category" ;
    rdfs:comment "Create a `zz-validation-<date>` category, confirm it lists, remove it, and confirm it is gone." ;
    qbt:contractOf qbt:skill-qbittorrent-torrent-lifecycle ;
    qbt:hasStep qbt:step-qbittorrent-category-roundtrip-1, qbt:step-qbittorrent-category-roundtrip-2, qbt:step-qbittorrent-category-roundtrip-3, qbt:step-qbittorrent-category-roundtrip-4, qbt:step-qbittorrent-category-roundtrip-5 .

qbt:step-qbittorrent-category-roundtrip-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "The categories before the test." ;
    qbt:precedesStep qbt:step-qbittorrent-category-roundtrip-2 .

qbt:step-qbittorrent-category-roundtrip-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_create_category ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Creates the test category." ;
    qbt:precedesStep qbt:step-qbittorrent-category-roundtrip-3 ;
    qbt:bindsParameter qbt:param-qbittorrent-category-roundtrip-2-category .

qbt:param-qbittorrent-category-roundtrip-2-category a qbt:ParameterBinding ;
    qbt:parameterName "category" ;
    qbt:parameterSource "const:\"zz-validation-2026-11-06\"" .

qbt:step-qbittorrent-category-roundtrip-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "The test category lists." ;
    qbt:precedesStep qbt:step-qbittorrent-category-roundtrip-4 .

qbt:step-qbittorrent-category-roundtrip-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_remove_categories ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Removes only the test category (destructive; `confirm=true`)." ;
    qbt:precedesStep qbt:step-qbittorrent-category-roundtrip-5 ;
    qbt:bindsParameter qbt:param-qbittorrent-category-roundtrip-4-categories .

qbt:param-qbittorrent-category-roundtrip-4-categories a qbt:ParameterBinding ;
    qbt:parameterName "categories" ;
    qbt:parameterSource "const:\"zz-validation-2026-11-06\"" .

qbt:step-qbittorrent-category-roundtrip-5 a qbt:ContractStep ; ;
    qbt:stepIndex 5 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "The test category is gone." .

qbt:contract-qbittorrent-add-torrent a qbt:ToolUseContract ;
    rdfs:label "Add a torrent to a category" ;
    rdfs:comment "Add a magnet link or URL the operator asked for into the consuming app's category, and confirm it is listed." ;
    qbt:contractOf qbt:skill-qbittorrent-torrent-lifecycle ;
    qbt:hasStep qbt:step-qbittorrent-add-torrent-1, qbt:step-qbittorrent-add-torrent-2, qbt:step-qbittorrent-add-torrent-3 .

qbt:step-qbittorrent-add-torrent-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "The category must exist (one per consuming app)." ;
    qbt:precedesStep qbt:step-qbittorrent-add-torrent-2 .

qbt:step-qbittorrent-add-torrent-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_add ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required: adds the torrent." ;
    qbt:precedesStep qbt:step-qbittorrent-add-torrent-3 ;
    qbt:bindsParameter qbt:param-qbittorrent-add-torrent-2-urls ;
    qbt:bindsParameter qbt:param-qbittorrent-add-torrent-2-category .

qbt:param-qbittorrent-add-torrent-2-urls a qbt:ParameterBinding ;
    qbt:parameterName "urls" ;
    qbt:parameterSource "operator input" .

qbt:param-qbittorrent-add-torrent-2-category a qbt:ParameterBinding ;
    qbt:parameterName "category" ;
    qbt:parameterSource "operator input" .

qbt:step-qbittorrent-add-torrent-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "The torrent lists in the category." ;
    qbt:bindsParameter qbt:param-qbittorrent-add-torrent-3-category .

qbt:param-qbittorrent-add-torrent-3-category a qbt:ParameterBinding ;
    qbt:parameterName "category" ;
    qbt:parameterSource "operator input" .

qbt:contract-qbittorrent-set-share-limits a qbt:ToolUseContract ;
    rdfs:label "Set seeding limits for completed torrents" ;
    rdfs:comment "Read completed torrents' ratio and seeding time, and set their share limits with approval." ;
    qbt:contractOf qbt:skill-qbittorrent-transfer-tuning ;
    qbt:hasStep qbt:step-qbittorrent-set-share-limits-1, qbt:step-qbittorrent-set-share-limits-2, qbt:step-qbittorrent-set-share-limits-3, qbt:step-qbittorrent-set-share-limits-4 .

qbt:step-qbittorrent-set-share-limits-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Completed torrents with `ratio` and `seeding_time`." ;
    qbt:precedesStep qbt:step-qbittorrent-set-share-limits-2 ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-1-filter .

qbt:param-qbittorrent-set-share-limits-1-filter a qbt:ParameterBinding ;
    qbt:parameterName "filter" ;
    qbt:parameterSource "const:\"completed\"" .

qbt:step-qbittorrent-set-share-limits-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_properties ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "One torrent's current share limits." ;
    qbt:precedesStep qbt:step-qbittorrent-set-share-limits-3 ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-2-hash .

qbt:param-qbittorrent-set-share-limits-2-hash a qbt:ParameterBinding ;
    qbt:parameterName "hash" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:step-qbittorrent-set-share-limits-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_set_share_limits ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required: `ratioLimit`, `seedingTimeLimit`, `inactiveSeedingTimeLimit` (-2 global, -1 none) and `shareLimitAction`." ;
    qbt:precedesStep qbt:step-qbittorrent-set-share-limits-4 ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-3-hashes ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-3-ratio_limit ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-3-seeding_time_limit ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-3-inactive_seeding_time_limit ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-3-share_limit_action .

qbt:param-qbittorrent-set-share-limits-3-hashes a qbt:ParameterBinding ;
    qbt:parameterName "hashes" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:param-qbittorrent-set-share-limits-3-ratio_limit a qbt:ParameterBinding ;
    qbt:parameterName "ratio_limit" ;
    qbt:parameterSource "operator input" .

qbt:param-qbittorrent-set-share-limits-3-seeding_time_limit a qbt:ParameterBinding ;
    qbt:parameterName "seeding_time_limit" ;
    qbt:parameterSource "operator input" .

qbt:param-qbittorrent-set-share-limits-3-inactive_seeding_time_limit a qbt:ParameterBinding ;
    qbt:parameterName "inactive_seeding_time_limit" ;
    qbt:parameterSource "const:-2" .

qbt:param-qbittorrent-set-share-limits-3-share_limit_action a qbt:ParameterBinding ;
    qbt:parameterName "share_limit_action" ;
    qbt:parameterSource "const:\"Default\"" .

qbt:step-qbittorrent-set-share-limits-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_properties ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Confirm the new limits." ;
    qbt:bindsParameter qbt:param-qbittorrent-set-share-limits-4-hash .

qbt:param-qbittorrent-set-share-limits-4-hash a qbt:ParameterBinding ;
    qbt:parameterName "hash" ;
    qbt:parameterSource "step1.result[].hash" .

qbt:contract-qbittorrent-set-speed-limits a qbt:ToolUseContract ;
    rdfs:label "Set global speed limits" ;
    rdfs:comment "Read and set the global download and upload limits with approval." ;
    qbt:contractOf qbt:skill-qbittorrent-transfer-tuning ;
    qbt:hasStep qbt:step-qbittorrent-set-speed-limits-1, qbt:step-qbittorrent-set-speed-limits-2, qbt:step-qbittorrent-set-speed-limits-3, qbt:step-qbittorrent-set-speed-limits-4, qbt:step-qbittorrent-set-speed-limits-5 .

qbt:step-qbittorrent-set-speed-limits-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_download_limit ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Bytes per second; 0 is unlimited." ;
    qbt:precedesStep qbt:step-qbittorrent-set-speed-limits-2 .

qbt:step-qbittorrent-set-speed-limits-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_upload_limit ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Bytes per second; 0 is unlimited." ;
    qbt:precedesStep qbt:step-qbittorrent-set-speed-limits-3 .

qbt:step-qbittorrent-set-speed-limits-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_set_download_limit ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required." ;
    qbt:precedesStep qbt:step-qbittorrent-set-speed-limits-4 ;
    qbt:bindsParameter qbt:param-qbittorrent-set-speed-limits-3-limit .

qbt:param-qbittorrent-set-speed-limits-3-limit a qbt:ParameterBinding ;
    qbt:parameterName "limit" ;
    qbt:parameterSource "operator input" .

qbt:step-qbittorrent-set-speed-limits-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_set_upload_limit ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required." ;
    qbt:precedesStep qbt:step-qbittorrent-set-speed-limits-5 ;
    qbt:bindsParameter qbt:param-qbittorrent-set-speed-limits-4-limit .

qbt:param-qbittorrent-set-speed-limits-4-limit a qbt:ParameterBinding ;
    qbt:parameterName "limit" ;
    qbt:parameterSource "operator input" .

qbt:step-qbittorrent-set-speed-limits-5 a qbt:ContractStep ; ;
    qbt:stepIndex 5 ; ;
    qbt:callsTool qbt:tool-qbittorrent_transfer_info ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Confirm `dl_rate_limit` and `up_rate_limit`." .

qbt:contract-qbittorrent-diagnose-app-connection a qbt:ToolUseContract ;
    rdfs:label "Diagnose an app that cannot reach qBittorrent" ;
    rdfs:comment "When an arr app reports its qBittorrent client unavailable, read the login failures and bans in the log and the WebUI auth settings, then hand the fix to the arr-mcp `arr-repair-download-client` workflow." ;
    qbt:contractOf qbt:skill-qbittorrent-download-client ;
    qbt:hasStep qbt:step-qbittorrent-diagnose-app-connection-1, qbt:step-qbittorrent-diagnose-app-connection-2, qbt:step-qbittorrent-diagnose-app-connection-3 .

qbt:step-qbittorrent-diagnose-app-connection-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_log_main ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "`WebAPI login failure ... invalid credentials` names the caller IP and user; `IP has been banned` means five failures locked it out for `web_ui_ban_duration` seconds." ;
    qbt:precedesStep qbt:step-qbittorrent-diagnose-app-connection-2 ;
    qbt:bindsParameter qbt:param-qbittorrent-diagnose-app-connection-1-normal ;
    qbt:bindsParameter qbt:param-qbittorrent-diagnose-app-connection-1-info ;
    qbt:bindsParameter qbt:param-qbittorrent-diagnose-app-connection-1-warning ;
    qbt:bindsParameter qbt:param-qbittorrent-diagnose-app-connection-1-critical .

qbt:param-qbittorrent-diagnose-app-connection-1-normal a qbt:ParameterBinding ;
    qbt:parameterName "normal" ;
    qbt:parameterSource "const:false" .

qbt:param-qbittorrent-diagnose-app-connection-1-info a qbt:ParameterBinding ;
    qbt:parameterName "info" ;
    qbt:parameterSource "const:false" .

qbt:param-qbittorrent-diagnose-app-connection-1-warning a qbt:ParameterBinding ;
    qbt:parameterName "warning" ;
    qbt:parameterSource "const:true" .

qbt:param-qbittorrent-diagnose-app-connection-1-critical a qbt:ParameterBinding ;
    qbt:parameterName "critical" ;
    qbt:parameterSource "const:false" .

qbt:step-qbittorrent-diagnose-app-connection-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_app_preferences ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "`web_ui_max_auth_fail_count`, `web_ui_ban_duration`, `bypass_local_auth`, `bypass_auth_subnet_whitelist_enabled`." ;
    qbt:precedesStep qbt:step-qbittorrent-diagnose-app-connection-3 .

qbt:step-qbittorrent-diagnose-app-connection-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Each consuming app's category exists." .

qbt:contract-qbittorrent-provision-app-category a qbt:ToolUseContract ;
    rdfs:label "Provision a category for a consuming app" ;
    rdfs:comment "Create the category an arr app sends its downloads to, so they land in the app's import folder." ;
    qbt:contractOf qbt:skill-qbittorrent-download-client ;
    qbt:hasStep qbt:step-qbittorrent-provision-app-category-1, qbt:step-qbittorrent-provision-app-category-2, qbt:step-qbittorrent-provision-app-category-3, qbt:step-qbittorrent-provision-app-category-4 .

qbt:step-qbittorrent-provision-app-category-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Skip if the app's category exists." ;
    qbt:precedesStep qbt:step-qbittorrent-provision-app-category-2 .

qbt:step-qbittorrent-provision-app-category-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_app_default_save_path ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Category folders sit under the default save path." ;
    qbt:precedesStep qbt:step-qbittorrent-provision-app-category-3 .

qbt:step-qbittorrent-provision-app-category-3 a qbt:ContractStep ; ;
    qbt:stepIndex 3 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_create_category ; ;
    qbt:needsApproval true ; ;
    rdfs:comment "Approval required: creates the category (`savePath` empty = default path plus the category name)." ;
    qbt:precedesStep qbt:step-qbittorrent-provision-app-category-4 ;
    qbt:bindsParameter qbt:param-qbittorrent-provision-app-category-3-category .

qbt:param-qbittorrent-provision-app-category-3-category a qbt:ParameterBinding ;
    qbt:parameterName "category" ;
    qbt:parameterSource "the app name (radarr, sonarr, lidarr, chaptarr)" .

qbt:step-qbittorrent-provision-app-category-4 a qbt:ContractStep ; ;
    qbt:stepIndex 4 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_categories ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Confirm it lists." .

qbt:contract-qbittorrent-ingest-torrents a qbt:ToolUseContract ;
    rdfs:label "Ingest torrents into the knowledge graph" ;
    rdfs:comment "Count the torrents and push them, with trackers and categories, into the knowledge graph." ;
    qbt:contractOf qbt:skill-qbittorrent-kg-ingestion ;
    qbt:hasStep qbt:step-qbittorrent-ingest-torrents-1, qbt:step-qbittorrent-ingest-torrents-2 .

qbt:step-qbittorrent-ingest-torrents-1 a qbt:ContractStep ; ;
    qbt:stepIndex 1 ; ;
    qbt:callsTool qbt:tool-qbittorrent_torrents_count ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "How many torrents the ingest will list." ;
    qbt:precedesStep qbt:step-qbittorrent-ingest-torrents-2 .

qbt:step-qbittorrent-ingest-torrents-2 a qbt:ContractStep ; ;
    qbt:stepIndex 2 ; ;
    qbt:callsTool qbt:tool-qbittorrent_ingest_torrents ; ;
    qbt:needsApproval false ; ;
    rdfs:comment "Lists torrents through `qbittorrent_torrents_info` and writes typed nodes; returns `listed` and `ingested`." ;
    qbt:bindsParameter qbt:param-qbittorrent-ingest-torrents-2-filter .

qbt:param-qbittorrent-ingest-torrents-2-filter a qbt:ParameterBinding ;
    qbt:parameterName "filter" ;
    qbt:parameterSource "operator input or none" .

qbt:prompt-torrent_operator a qbt:ConnectorPrompt ;
    rdfs:label "Torrent Operator" ;
    qbt:promptName "torrent_operator" ;
    qbt:systemPromptForRole qbt:TorrentOperator ;
    qbt:usesSkill qbt:skill-qbittorrent-agent-operations, qbt:skill-qbittorrent-torrent-lifecycle, qbt:skill-qbittorrent-transfer-tuning, qbt:skill-qbittorrent-download-client, qbt:skill-qbittorrent-kg-ingestion ;
    qbt:runsContract qbt:contract-qbittorrent-check-transfer-health, qbt:contract-qbittorrent-recover-stalled-torrent, qbt:contract-qbittorrent-category-roundtrip, qbt:contract-qbittorrent-add-torrent, qbt:contract-qbittorrent-set-share-limits, qbt:contract-qbittorrent-set-speed-limits, qbt:contract-qbittorrent-diagnose-app-connection, qbt:contract-qbittorrent-provision-app-category, qbt:contract-qbittorrent-ingest-torrents ;
    qbt:usesTool qbt:tool-qbittorrent_transfer_info, qbt:tool-qbittorrent_transfer_speed_limits_mode, qbt:tool-qbittorrent_torrents_info, qbt:tool-qbittorrent_log_main, qbt:tool-qbittorrent_torrents_trackers, qbt:tool-qbittorrent_torrents_reannounce, qbt:tool-qbittorrent_torrents_recheck, qbt:tool-qbittorrent_torrents_properties, qbt:tool-qbittorrent_torrents_categories, qbt:tool-qbittorrent_torrents_create_category, qbt:tool-qbittorrent_torrents_remove_categories, qbt:tool-qbittorrent_torrents_add, qbt:tool-qbittorrent_torrents_set_share_limits, qbt:tool-qbittorrent_transfer_download_limit, qbt:tool-qbittorrent_transfer_upload_limit, qbt:tool-qbittorrent_transfer_set_download_limit, qbt:tool-qbittorrent_transfer_set_upload_limit, qbt:tool-qbittorrent_app_preferences, qbt:tool-qbittorrent_app_default_save_path, qbt:tool-qbittorrent_torrents_count, qbt:tool-qbittorrent_ingest_torrents .

qbt:prompt-torrent_download_monitor a qbt:ConnectorPrompt ;
    rdfs:label "Torrent Download Monitor" ;
    qbt:promptName "torrent_download_monitor" ;
    qbt:systemPromptForRole qbt:TorrentDownloadMonitor ;
    qbt:usesSkill qbt:skill-qbittorrent-transfer-tuning, qbt:skill-qbittorrent-torrent-lifecycle ;
    qbt:runsContract qbt:contract-qbittorrent-check-transfer-health, qbt:contract-qbittorrent-recover-stalled-torrent ;
    qbt:usesTool qbt:tool-qbittorrent_transfer_info, qbt:tool-qbittorrent_transfer_speed_limits_mode, qbt:tool-qbittorrent_torrents_info, qbt:tool-qbittorrent_log_main, qbt:tool-qbittorrent_torrents_trackers, qbt:tool-qbittorrent_torrents_reannounce, qbt:tool-qbittorrent_torrents_recheck, qbt:tool-qbittorrent_torrents_properties .

qbt:prompt-seeding_manager a qbt:ConnectorPrompt ;
    rdfs:label "Seeding Manager" ;
    qbt:promptName "seeding_manager" ;
    qbt:systemPromptForRole qbt:SeedingManager ;
    qbt:usesSkill qbt:skill-qbittorrent-transfer-tuning ;
    qbt:runsContract qbt:contract-qbittorrent-set-share-limits, qbt:contract-qbittorrent-set-speed-limits, qbt:contract-qbittorrent-check-transfer-health ;
    qbt:usesTool qbt:tool-qbittorrent_torrents_info, qbt:tool-qbittorrent_torrents_properties, qbt:tool-qbittorrent_torrents_set_share_limits, qbt:tool-qbittorrent_transfer_download_limit, qbt:tool-qbittorrent_transfer_upload_limit, qbt:tool-qbittorrent_transfer_set_download_limit, qbt:tool-qbittorrent_transfer_set_upload_limit, qbt:tool-qbittorrent_transfer_info, qbt:tool-qbittorrent_transfer_speed_limits_mode, qbt:tool-qbittorrent_log_main .

qbt:prompt-download_client_steward a qbt:ConnectorPrompt ;
    rdfs:label "Download Client Steward" ;
    qbt:promptName "download_client_steward" ;
    qbt:systemPromptForRole qbt:DownloadClientSteward ;
    qbt:usesSkill qbt:skill-qbittorrent-download-client, qbt:skill-qbittorrent-torrent-lifecycle ;
    qbt:runsContract qbt:contract-qbittorrent-diagnose-app-connection, qbt:contract-qbittorrent-provision-app-category, qbt:contract-qbittorrent-category-roundtrip ;
    qbt:usesTool qbt:tool-qbittorrent_log_main, qbt:tool-qbittorrent_app_preferences, qbt:tool-qbittorrent_torrents_categories, qbt:tool-qbittorrent_app_default_save_path, qbt:tool-qbittorrent_torrents_create_category, qbt:tool-qbittorrent_torrents_remove_categories .
