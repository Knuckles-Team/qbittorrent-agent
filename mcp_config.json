{
  "mcpServers": {
    "qbittorrent-agent": {
      "command": "uv",
      "args": [
        "run",
        "qbittorrent-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "APPTOOL": "True",
        "LOGTOOL": "True",
        "QBITTORRENT_PASSWORD": "",
        "QBITTORRENT_URL": "",
        "QBITTORRENT_USERNAME": "",
        "RSSTOOL": "True",
        "SEARCHTOOL": "True",
        "SYNCTOOL": "True",
        "TORRENTSTOOL": "True",
        "TRANSFERTOOL": "True"
      }
    }
  }
}
