{
  "mcpServers": {
    "qbittorrent-agent": {
      "command": "uv",
      "args": [
        "run",
        "qbittorrent-mcp"
      ],
      "env": {
        "APPTOOL": "True",
        "LOGTOOL": "True",
        "RSSTOOL": "True",
        "SEARCHTOOL": "True",
        "SYNCTOOL": "True",
        "TORRENTSTOOL": "True",
        "TRANSFERTOOL": "True"
      }
    }
  }
}
